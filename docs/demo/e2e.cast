[47.282112, "o", "\u001b[36m\u001b[1m→ save_draft_reply\u001b[0m\u001b[36m({\"ticket_id\": \"T-5103\", \"reply_text\": \"Hi Rizal,\\n\\nI'm sorry you've had to write to us three times, and tha...\", \"internal_note\": \"Escalated to team lead (chargeback/legal threat). Do not give a KYC...\"})\u001b[0m\r\n"]
